// NotesChain — Prisma schema
// See ARCHITECTURE.md for the rationale behind nullable onChainPublicationId,
// the OutboxEvent/WorkerJob split, and why Publication.content is a
// rebuildable cache rather than a source of truth.

generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev (Windows/macOS/glibc Linux); the musl+OpenSSL
  // 3.0 target matches the Alpine 3.19+ runtime image the Dockerfile builds.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum IdentityType {
  REAL_NAME
  PSEUDONYM
}

enum IdentityMode {
  NAMED
  PSEUDONYMOUS
  ANONYMOUS
}

enum Discoverability {
  PUBLIC
  UNLISTED
}

/// How a note's stored text should be interpreted when rendering.
///
/// PLAINTEXT is the default on purpose, and the default matters. Every note
/// published before markdown support is immutable and already hashed; a note
/// containing `*asterisks*` must keep rendering as asterisks forever. Because
/// the default fails toward "render literally", a code path that forgets to
/// set this shows the writer's characters as typed rather than silently
/// reinterpreting permanent content.
enum ContentFormat {
  PLAINTEXT
  MARKDOWN
}

enum DraftStatus {
  DRAFT
  PENDING_REVIEW
  CHANGES_REQUESTED
  REJECTED
  APPROVED
  CHAIN_PENDING
  CHAIN_SUBMITTED
  PUBLISHED
  CHAIN_FAILED
  ARCHIVED
}

enum ModerationAction {
  APPROVE
  REJECT
  REQUEST_CHANGES
}

enum ChainStatus {
  NOT_SUBMITTED
  QUEUED
  SUBMITTING
  SUBMITTED
  CONFIRMED
  FINALIZED
  FAILED_RETRYABLE
  FAILED_PERMANENT
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum ReportStatus {
  OPEN
  RESOLVED
}

enum ReportResolution {
  DISMISSED
  DELISTED
  USER_SUSPENDED
}

enum CommentReportResolution {
  DISMISSED
  COMMENT_REMOVED
  USER_SUSPENDED
}

/// Every transactional email NotesChain sends. Must stay byte-identical to
/// the hand-mirrored `EmailKind` object in packages/email/src/kinds.ts —
/// that package is deliberately Prisma-free, so nothing enforces the two
/// staying in sync automatically. Change both in the same commit.
enum EmailKind {
  PUBLICATION_APPROVED
  PUBLICATION_REJECTED
  PUBLICATION_CHANGES_REQUESTED
  PUBLICATION_CHAIN_FINALIZED
  PASSWORD_RESET_REQUESTED
  ACCOUNT_WELCOME
  COMMENT_RECEIVED
}

enum EmailJobStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

// ── Auth ─────────────────────────────────────────────────────────────────

model User {
  id                 String        @id @default(uuid())
  email              String        @unique
  passwordHash       String
  role               Role          @default(USER)
  status             AccountStatus @default(ACTIVE)
  emailVerifiedAt    DateTime?
  commentDisplayName String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  lastLoginAt        DateTime?

  sessions               Session[]
  passwordResetTokens    PasswordResetToken[]
  identities             PublicIdentity[]
  drafts                 Draft[]
  submissions            Submission[]         @relation("SubmittedBy")
  moderationDecisions    ModerationDecision[] @relation("ModeratedBy")
  publications           Publication[]        @relation("PrivateAuthor")
  bookmarks              Bookmark[]
  bookmarkCollections    BookmarkCollection[]
  reportsFiled           Report[]             @relation("ReportedBy")
  reportsResolved        Report[]             @relation("ResolvedBy")
  auditLogs              AuditLog[]
  comments               Comment[]            @relation("CommentAuthor")
  commentReportsFiled    CommentReport[]      @relation("CommentReportedBy")
  commentReportsResolved CommentReport[]      @relation("CommentReportResolvedBy")
  emailJobs              EmailJob[]

  @@index([status])
}

model Session {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  csrfSecret String
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  userAgent  String?
  ipAddress  String?

  @@index([userId])
  @@index([expiresAt])
}

/// Same shape as Session's token handling: only the SHA-256 hash is ever
/// persisted, the raw token is emailed once and never stored anywhere. A
/// token is single-use (usedAt) and short-lived (expiresAt); resetPassword()
/// also revokes every existing Session for the user once a reset succeeds,
/// so a stolen session cookie can't outlive a password change.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ── Identities ───────────────────────────────────────────────────────────

model PublicIdentity {
  id          String       @id @default(uuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        IdentityType
  username    String       @unique
  displayName String
  bio         String       @default("")
  avatarUrl   String?
  links       String[]     @default([])
  isVisible   Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  drafts       Draft[]
  publications Publication[]

  @@index([userId])
}

// ── Drafts ───────────────────────────────────────────────────────────────

model Draft {
  id               String          @id @default(uuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String          @default("")
  content          String          @default("")
  /// New drafts are markdown; existing ones stay plaintext.
  contentFormat    ContentFormat   @default(MARKDOWN)
  tags             String[]        @default([])
  identityMode     IdentityMode    @default(NAMED)
  publicIdentityId String?
  publicIdentity   PublicIdentity? @relation(fields: [publicIdentityId], references: [id])
  discoverability  Discoverability @default(PUBLIC)
  status           DraftStatus     @default(DRAFT)
  lastSavedAt      DateTime        @default(now())
  submittedAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  versions    DraftVersion[]
  submissions Submission[]
  publication Publication?

  @@index([userId, status])
}

model DraftVersion {
  id            String   @id @default(uuid())
  draftId       String
  draft         Draft    @relation(fields: [draftId], references: [id], onDelete: Cascade)
  versionNumber Int
  title         String
  content       String
  createdAt     DateTime @default(now())

  @@unique([draftId, versionNumber])
}

// ── Moderation ───────────────────────────────────────────────────────────

model Submission {
  id                       String          @id @default(uuid())
  draftId                  String
  draft                    Draft           @relation(fields: [draftId], references: [id], onDelete: Cascade)
  submittedByUserId        String
  submittedBy              User            @relation("SubmittedBy", fields: [submittedByUserId], references: [id])
  titleSnapshot            String
  contentSnapshot          String
  /// Snapshotted so a Submission created before markdown shipped but
  /// approved after it still renders the way its author saw it.
  contentFormatSnapshot    ContentFormat   @default(PLAINTEXT)
  tagsSnapshot             String[]        @default([])
  identityModeSnapshot     IdentityMode
  publicIdentityIdSnapshot String?
  discoverabilitySnapshot  Discoverability
  status                   DraftStatus
  createdAt                DateTime        @default(now())
  decidedAt                DateTime?

  decisions ModerationDecision[]

  @@index([status, createdAt])
  @@index([draftId])
}

model ModerationDecision {
  id              String           @id @default(uuid())
  submissionId    String
  submission      Submission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  moderatorUserId String
  moderator       User             @relation("ModeratedBy", fields: [moderatorUserId], references: [id])
  action          ModerationAction
  reason          String
  note            String?
  flaggedPii      Boolean          @default(false)
  flaggedAbuse    Boolean          @default(false)
  createdAt       DateTime         @default(now())

  @@index([submissionId])
}

// ── Publications (off-chain read model) ─────────────────────────────────

model Publication {
  id                    String          @id @default(uuid())
  sourceDraftId         String?         @unique
  sourceDraft           Draft?          @relation(fields: [sourceDraftId], references: [id])
  privateAuthorUserId   String
  privateAuthor         User            @relation("PrivateAuthor", fields: [privateAuthorUserId], references: [id])
  publicIdentityId      String?
  publicIdentity        PublicIdentity? @relation(fields: [publicIdentityId], references: [id])
  identityMode          IdentityMode
  discoverability       Discoverability
  title                 String
  /// The note as written. Markdown source when contentFormat is MARKDOWN —
  /// this exact string is what the content hash covers.
  content               String
  contentFormat         ContentFormat   @default(PLAINTEXT)
  /// Markup stripped. Feeds the search vector and ts_headline, so `**bold**`
  /// never reaches the index or a search snippet.
  contentPlain          String          @default("")
  /// UTF-8 byte length of `content`, cross-checked against the on-chain
  /// content_length for v2 publications.
  contentBytes          Int             @default(0)
  /// From the v2 schema onward this is INSIDE the content-hash preimage, so
  /// it is permanent. Never recompute it for a published row — an algorithm
  /// change would break verification for every affected note.
  excerpt               String
  tags                  String[]        @default([])
  contentHash           String
  /// Which on-chain Publication layout this row was published under.
  /// 1 = body stored on-chain; 2 = only the digest is on-chain.
  chainSchemaVersion    Int             @default(1)
  status                DraftStatus
  isPlatformVisible     Boolean         @default(true)
  delistingReason       String?
  // Nullable until the worker confirms which id the chain actually assigned
  // — see ARCHITECTURE.md §3.1 for why the id cannot be chosen client-side.
  onChainPublicationId  BigInt?         @unique
  previousPublicationId String?
  previousPublication   Publication?    @relation("PublicationRevisions", fields: [previousPublicationId], references: [id])
  revisions             Publication[]   @relation("PublicationRevisions")
  commentsEnabled       Boolean         @default(true)
  publishedAt           DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  // Kept in sync by a BEFORE INSERT/UPDATE trigger added by hand in
  // prisma/migrations/*_add_search_vector/migration.sql (Postgres rejects
  // to_tsvector() inside a GENERATED ALWAYS AS ... STORED expression as
  // "not immutable"). `Unsupported` so Prisma Client ignores it in normal
  // queries; the search module reads it via `$queryRaw` instead.
  searchVector Unsupported("tsvector")?

  chainRecord     PublicationChainRecord?
  publicationTags PublicationTag[]
  bookmarks       Bookmark[]
  reports         Report[]
  views           PublicationView[]
  comments        Comment[]

  @@index([discoverability, isPlatformVisible, status])
  @@index([publicIdentityId])
  @@index([privateAuthorUserId])
  @@index([createdAt])
  @@index([searchVector], type: Gin)
}

model PublicationChainRecord {
  id                   String      @id @default(uuid())
  publicationId        String      @unique
  publication          Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  network              String
  programId            String
  publicationPda       String?
  transactionSignature String?
  slot                 BigInt?
  blockTime            DateTime?
  chainStatus          ChainStatus @default(NOT_SUBMITTED)
  submissionAttempts   Int         @default(0)
  lastError            String?
  submittedAt          DateTime?
  confirmedAt          DateTime?
  finalizedAt          DateTime?
  lastVerifiedAt       DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@index([chainStatus])
  @@index([transactionSignature])
}

// ── Tags ─────────────────────────────────────────────────────────────────

model Tag {
  id        String   @id @default(uuid())
  slug      String   @unique
  label     String
  createdAt DateTime @default(now())

  publicationTags PublicationTag[]
}

model PublicationTag {
  publicationId String
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  tagId         String
  tag           Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([publicationId, tagId])
  @@index([tagId])
}

// ── Bookmarks ────────────────────────────────────────────────────────────

model BookmarkCollection {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookmarks Bookmark[]

  @@unique([userId, name])
}

model Bookmark {
  id            String              @id @default(uuid())
  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  publicationId String
  publication   Publication         @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  collectionId  String?
  collection    BookmarkCollection? @relation(fields: [collectionId], references: [id])
  createdAt     DateTime            @default(now())

  @@unique([userId, publicationId])
  @@index([collectionId])
}

// ── Reports ──────────────────────────────────────────────────────────────

model Report {
  id               String            @id @default(uuid())
  publicationId    String
  publication      Publication       @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  reporterUserId   String?
  reporter         User?             @relation("ReportedBy", fields: [reporterUserId], references: [id])
  reason           String
  status           ReportStatus      @default(OPEN)
  resolution       ReportResolution?
  resolutionNote   String?
  resolvedByUserId String?
  resolvedBy       User?             @relation("ResolvedBy", fields: [resolvedByUserId], references: [id])
  resolvedAt       DateTime?
  createdAt        DateTime          @default(now())

  @@index([status])
  @@index([publicationId])
}

// ── Comments ─────────────────────────────────────────────────────────────

model Comment {
  id            String      @id @default(uuid())
  publicationId String
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  parentCommentId String?
  parentComment   Comment?  @relation("CommentReplies", fields: [parentCommentId], references: [id])
  replies         Comment[] @relation("CommentReplies")

  // Denormalized pointer straight to the top-level ancestor (null if this
  // row IS top-level). Set once at creation to parentComment.rootCommentId
  // ?? parentComment.id — makes "fetch everything under top-level comment
  // X" an indexed equality filter instead of a recursive walk. The UI
  // renders only 2 visual levels (every reply-to-a-reply flattens under the
  // original top-level comment) even though parentCommentId supports
  // arbitrary depth.
  rootCommentId String?
  rootComment   Comment?  @relation("CommentRoot", fields: [rootCommentId], references: [id])
  descendants   Comment[] @relation("CommentRoot")

  authorUserId              String
  author                    User    @relation("CommentAuthor", fields: [authorUserId], references: [id])
  isAnonymous               Boolean @default(false)
  // Point-in-time snapshot, not a live join — a later commentDisplayName
  // change doesn't retroactively relabel past comments.
  authorDisplayNameSnapshot String?

  body String

  isVisible     Boolean  @default(true)
  removalReason String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  reports CommentReport[]

  @@index([publicationId, parentCommentId, createdAt])
  @@index([rootCommentId])
  @@index([authorUserId])
}

model CommentReport {
  id               String                   @id @default(uuid())
  commentId        String
  comment          Comment                  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporterUserId   String?
  reporter         User?                    @relation("CommentReportedBy", fields: [reporterUserId], references: [id])
  reason           String
  status           ReportStatus             @default(OPEN)
  resolution       CommentReportResolution?
  resolutionNote   String?
  resolvedByUserId String?
  resolvedBy       User?                    @relation("CommentReportResolvedBy", fields: [resolvedByUserId], references: [id])
  resolvedAt       DateTime?
  createdAt        DateTime                 @default(now())

  @@index([status])
  @@index([commentId])
}

// ── Analytics ────────────────────────────────────────────────────────────

// Deliberately no userId/ipAddress/full referrer URL — just enough to
// answer "which platform did this come from," matching the privacy
// posture of the rest of the app (IP is logged on Session/AuditLog for
// security-relevant events only, not page views). visitorHash is a
// SHA-256 hash of an opaque first-party cookie, never an IP, account id, or
// browser fingerprint. Legacy raw pageviews predate this field and stay null.
model PublicationView {
  id            String      @id @default(uuid())
  publicationId String
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  referrerHost  String?
  visitorHash   String?
  createdAt     DateTime    @default(now())

  @@unique([publicationId, visitorHash])
  @@index([publicationId, createdAt])
  @@index([utmSource])
  @@index([createdAt])
}

// ── Blockchain outbox / worker ──────────────────────────────────────────

model OutboxEvent {
  id            String       @id @default(uuid())
  eventType     String
  aggregateType String
  aggregateId   String
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now())
  lockedAt      DateTime?
  lockedBy      String?
  processedAt   DateTime?
  lastError     String?
  createdAt     DateTime     @default(now())

  job WorkerJob?

  @@unique([aggregateType, aggregateId, eventType])
  @@index([status, availableAt])
}

model WorkerJob {
  id            String       @id @default(uuid())
  outboxEventId String       @unique
  outboxEvent   OutboxEvent  @relation(fields: [outboxEventId], references: [id], onDelete: Cascade)
  kind          String
  publicationId String
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  maxAttempts   Int          @default(8)
  nextAttemptAt DateTime     @default(now())
  lastError     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status, nextAttemptAt])
  @@index([publicationId])
}

// ── Email ────────────────────────────────────────────────────────────────

/// A durable, retryable send request — the email equivalent of
/// OutboxEvent/WorkerJob, but deliberately its own table rather than a
/// reuse of those. WorkerJob.publicationId is required and non-nullable and
/// outboxProcessor.ts unconditionally dispatches to the chain-publish
/// pipeline; making that generic would mean touching the code path that
/// handles irreversible on-chain publishing for no real benefit. This copies
/// the same claim/backoff shape (see apps/worker/src/email/claimEmailJob.ts,
/// which mirrors apps/worker/src/publishing/claimJob.ts almost line for
/// line) without touching that table at all.
///
/// Rows are inserted in the SAME transaction as the business event that
/// causes them (a moderation decision, a comment, a signup) — if that
/// transaction rolls back, the notification never gets queued either.
/// Rendering happens at send time (see the worker's emailProcessor.ts), not
/// here at enqueue time, so a template fix applies even to jobs already
/// sitting in the queue when it ships. `data` is validated against the
/// per-kind zod schema in packages/email BEFORE this row is ever created,
/// so a malformed payload fails loudly at the call site, not silently later
/// when the worker tries to render it.
model EmailJob {
  id            String         @id @default(uuid())
  kind          EmailKind
  toEmail       String
  toUserId      String?
  toUser        User?          @relation(fields: [toUserId], references: [id])
  data          Json
  status        EmailJobStatus @default(PENDING)
  attempts      Int            @default(0)
  maxAttempts   Int            @default(5)
  nextAttemptAt DateTime       @default(now())
  lastError     String?
  sentAt        DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status, nextAttemptAt])
  @@index([toUserId])
}

// ── Operational ──────────────────────────────────────────────────────────

// One row per long-running process (currently just "worker"), updated on a
// timer so /api/v1/health/ready can report whether the worker is alive
// without needing a separate process-to-process channel.
model ProcessHeartbeat {
  process    String   @id
  lastBeatAt DateTime
  meta       Json?
}

// ── Audit ────────────────────────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id])
  action      String
  targetType  String?
  targetId    String?
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([action, createdAt])
  @@index([targetType, targetId])
}
