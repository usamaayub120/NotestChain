{
  "expo": {
    "name": "NotesChain",
    "slug": "noteschain",
    "scheme": "noteschain",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "org.noteschain.app",
      "associatedDomains": [
        "applinks:noteschain.org"
      ]
    },
    "android": {
      "package": "org.noteschain.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "noteschain.org",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "7ef4befc-5352-4d71-9743-0266664dde9c"
      }
    },
    "owner": "usamaayub00"
  }
}
