# Copy to .env for local `expo start` — never committed (see .gitignore).
# Only needed to point a development build at something other than production
# (e.g. an API running on your LAN). Leave unset to use noteschain.org.
APP_ENV=development
EXPO_PUBLIC_API_ORIGIN=http://192.168.1.10:4000
EXPO_PUBLIC_WEB_ORIGIN=http://192.168.1.10:5173
