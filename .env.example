# ── Core ──────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_VERSION=0.1.0
PORT=3001
WEB_PORT=5173

# ── Database (Postgres is external — never bundled in the app image) ──────
# Matches docker-compose.dev.yml's postgres service. If port 5432 is already
# in use by another local Postgres install, change the published port in
# docker-compose.dev.yml and this URL together (e.g. "15432:5432").
DATABASE_URL=postgresql://noteschain:noteschain@localhost:5432/noteschain

# ── Sessions / cookies / CSRF ───────────────────────────────────────────────
# 32+ byte random secret used to sign the CSRF cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-64-char-hex-secret
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:5173

# ── Rate limiting ────────────────────────────────────────────────────────
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000

# ── Solana ───────────────────────────────────────────────────────────────
SOLANA_CLUSTER=devnet
SOLANA_RPC_HTTP_URL=https://api.devnet.solana.com
SOLANA_RPC_WS_URL=wss://api.devnet.solana.com
SOLANA_PROGRAM_ID=exQDCAihgmrV4FNPpuQXrFXp2pvKUumntCfantzc5GX
SOLANA_COMMITMENT=confirmed

# Production: path to a keypair JSON mounted as a secret, never committed.
SOLANA_PUBLISHER_KEYPAIR_PATH=/run/secrets/solana-publisher.json
# Local dev only fallback (never set this in production):
# SOLANA_PUBLISHER_KEYPAIR_JSON=[12,34,...]

PUBLIC_EXPLORER_BASE_URL=https://explorer.solana.com

# ── Worker ───────────────────────────────────────────────────────────────
WORKER_POLL_INTERVAL_MS=4000
WORKER_MAX_ATTEMPTS=8
WORKER_RECONCILE_INTERVAL_MS=300000

# ── Logging ──────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── CAPTCHA (Cloudflare Turnstile) ─────────────────────────────────────────
# Left unset, the API skips captcha verification (a warning is logged each
# time in production). Set this once a Cloudflare Turnstile site exists —
# get real keys from the Cloudflare dashboard → Turnstile.
# VITE_TURNSTILE_SITE_KEY belongs in apps/web's own env (Vite only exposes
# VITE_-prefixed vars to the client); left unset there, the widget doesn't
# render and registration proceeds without one, matching the backend's bypass.
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=
