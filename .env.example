# ── Core ──────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_VERSION=0.1.0
PORT=3001
WEB_PORT=5173

# ── Android release policy automation ─────────────────────────────────────
# Optional shared secret for GitHub's Android release workflow. It lets the
# workflow advance latestBuild only after Google Play reports the AAB as
# available. Generate a random 32+ character value and store the exact same
# value as the NOTESCHAIN_RELEASE_POLICY_TOKEN GitHub repository secret.
# Minimum supported build remains an explicit Admin → Settings decision.
# RELEASE_POLICY_WEBHOOK_SECRET=

# ── Database (Postgres is external — never bundled in the app image) ──────
# Matches docker-compose.dev.yml's postgres service. If port 5432 is already
# in use by another local Postgres install, change the published port in
# docker-compose.dev.yml and this URL together (e.g. "15432:5432").
DATABASE_URL=postgresql://noteschain:noteschain@localhost:5432/noteschain

# ── Sessions / cookies / CSRF ───────────────────────────────────────────────
# 32+ byte random secret used to sign the CSRF cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-64-char-hex-secret
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:5173

# ── Rate limiting ────────────────────────────────────────────────────────
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000

# ── Solana ───────────────────────────────────────────────────────────────
SOLANA_CLUSTER=devnet
SOLANA_RPC_HTTP_URL=https://api.devnet.solana.com
SOLANA_RPC_WS_URL=wss://api.devnet.solana.com
SOLANA_PROGRAM_ID=exQDCAihgmrV4FNPpuQXrFXp2pvKUumntCfantzc5GX
SOLANA_COMMITMENT=confirmed

# Production: path to a keypair JSON mounted as a secret, never committed.
SOLANA_PUBLISHER_KEYPAIR_PATH=/run/secrets/solana-publisher.json
# Local dev only fallback (never set this in production):
# SOLANA_PUBLISHER_KEYPAIR_JSON=[12,34,...]

PUBLIC_EXPLORER_BASE_URL=https://explorer.solana.com

# Admin "wallet balances" page — PUBLIC keys only, never a secret. The API
# never loads either keypair's secret half; these just let it show which
# accounts matter and query their balance via a plain getBalance(pubkey)
# read. SOLANA_PUBLISHER_PUBLIC_KEY is deployment-specific (derive it from
# the real keypair file without ever printing the secret half — see
# RUNBOOK.md); SOLANA_UPGRADE_AUTHORITY_PUBLIC_KEY defaults to this
# deployment's known value. The worker derives the publisher's pubkey from
# its own loaded keypair instead, so it doesn't need the first one.
SOLANA_PUBLISHER_PUBLIC_KEY=
SOLANA_UPGRADE_AUTHORITY_PUBLIC_KEY=BCYqFNE6WQQM6pq8td6qwNxu8N1k39amAbfiuaiHmvmH
SOLANA_PUBLISHER_LOW_BALANCE_SOL=0.05
SOLANA_UPGRADE_AUTHORITY_LOW_BALANCE_SOL=1

# ── Worker ───────────────────────────────────────────────────────────────
WORKER_POLL_INTERVAL_MS=4000
WORKER_MAX_ATTEMPTS=8
WORKER_RECONCILE_INTERVAL_MS=300000
WORKER_BALANCE_CHECK_INTERVAL_MS=1800000

# ── Logging ──────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── SEO ──────────────────────────────────────────────────────────────────
# Directory containing the built web app's index.html (see apps/api/src/
# modules/seo). Defaults to Nginx's own web root, correct for the Docker
# image as-is. For local dev, only needed if you're testing the SEO routes
# directly against a production build:
#   pnpm --filter @noteschain/web build && WEB_DIST_DIR=apps/web/dist ...
# WEB_DIST_DIR=/usr/share/nginx/html

# ── Email (SMTP) ─────────────────────────────────────────────────────────
# Left unset, the API queues emails as PENDING and warns at startup; the
# worker (which is the process that actually sends) hard-fails at startup
# if these aren't set in production. Any SMTP provider works — plain
# nodemailer underneath, no code depends on which one you use.
#
# Recommended: Resend (resend.com) — sign up, add + verify your domain (it
# gives you SPF/DKIM TXT records to add wherever your DNS is hosted, e.g.
# Cloudflare, even if the domain itself is registered elsewhere), then use
# its SMTP relay directly below: host smtp.resend.com, port 587, user
# "resend", password = your Resend API key.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=NotesChain

# Used to build links back into the app from inside an email (a draft's edit
# page, a password-reset link, a published note's reader page).
PUBLIC_WEB_ORIGIN=http://localhost:5173

# ── Push notifications (Firebase Cloud Messaging) ──────────────────────────
# Left unset, the API queues pushes as PENDING and the worker logs a warning
# at startup but keeps running — unlike SMTP, this never hard-fails: push is
# an enhancement, not core to the product. Same PATH/JSON pair as
# SOLANA_PUBLISHER_KEYPAIR_PATH/_JSON above: a mounted secret file in
# production, an inline value for local dev only (refused if NODE_ENV=production).
#
# This is a Firebase *service account* key (Firebase Console -> Project
# Settings -> Service Accounts -> Generate new private key) — not the same
# file as apps/mobile/google-services.json, which is the Android client's
# own registration config and lives in the mobile app, not here.
FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/firebase-service-account.json
# Local dev only fallback (never set this in production):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# A distinct mounted 32-byte base64 key shared by the API and worker. It
# encrypts FCM registration tokens at rest; never put the key itself in git.
PUSH_TOKEN_ENCRYPTION_KEY_PATH=/run/secrets/push-token-encryption.key

# ── CAPTCHA (Cloudflare Turnstile) ─────────────────────────────────────────
# Left unset, the API skips captcha verification (a warning is logged each
# time in production). Set this once a Cloudflare Turnstile site exists —
# get real keys from the Cloudflare dashboard → Turnstile.
# VITE_TURNSTILE_SITE_KEY belongs in apps/web's own env (Vite only exposes
# VITE_-prefixed vars to the client); left unset there, the widget doesn't
# render and registration proceeds without one, matching the backend's bypass.
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=
# Optional: Azure Translator F0 resource only. Never upgrade automatically to a paid tier.
# Keep these values server-side. An absent key disables translation, not the API.
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
